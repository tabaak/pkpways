# Caddy site config — mounted read-only into the caddy service.
#
# Replace REPLACE_WITH_YOUR_DOMAIN below with the real hostname before
# deploying. Caddy requests a Let's Encrypt certificate for whatever name is
# written here, so it must match the DNS A record pointing at this VPS.
#
# Reload after editing (no downtime):
#   sudo docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

pkpways.vokh.dev {
	encode zstd gzip

	# "frontend" resolves over the internal compose network; 3000 is the port
	# inside that container, not on the host.
	reverse_proxy frontend:3000
}

# hop tunnels — https://<name>.hop.vokh.dev reaches an agent's local port.
#
# The wildcard can only be validated by DNS-01, which is why this Caddy is
# built with the Cloudflare provider (see caddy/Dockerfile).
#
# hopd runs on the host under systemd rather than in this stack, so tunnels
# survive compose restarts; host.docker.internal is mapped to the docker0
# bridge address by extra_hosts in docker-compose.yml.
#
# Deliberately no `encode` here: compressing tunnel traffic would interfere
# with streaming responses (SSE, chunked) that pass through untouched.
*.hop.vokh.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy host.docker.internal:8080
}
