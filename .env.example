# Docker Compose datastore config. Copy to .env and set real passwords.
#   cp .env.example .env
# .env is gitignored — never commit it.

# --- PostgreSQL ---
POSTGRES_DB=pkpways
POSTGRES_USER=pkpways
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Redis ---
REDIS_PASSWORD=replace-with-a-strong-password
# Sized for the measured VPS: ~97 MB current / ~483 MB historical Redis peak,
# with 11.65 GB host RAM. Keep the container limit above maxmemory for allocator
# overhead while preventing Redis from consuming the whole VPS.
REDIS_MAXMEMORY=768mb
REDIS_CONTAINER_MEMORY=1g

# --- data-sync worker ---
# The worker runs as a compose service and builds DATABASE_URL / REDIS_URL from
# the values above (hosts "postgres"/"redis"), so you only need the API key.
PKP_API_KEY=replace-with-your-pkp-api-key
# Optional overrides:
# PKP_API_BASE_URL=https://pdp-api.plk-sa.pl/api/v1
# POLL_INTERVAL_SECONDS=30
# REQUEST_TIMEOUT_SECONDS=10
# CACHE_TTL_SECONDS=1800
# LOG_LEVEL=INFO
