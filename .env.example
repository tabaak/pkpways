# Docker Compose datastore config. Copy to .env and set real passwords.
#   cp .env.example .env
# .env is gitignored — never commit it.

# --- PostgreSQL ---
POSTGRES_DB=pkpways
POSTGRES_USER=pkpways
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Redis ---
REDIS_PASSWORD=replace-with-a-strong-password

# --- Connection strings for the data-sync worker (for reference) ---
# When the worker runs on the same VPS (host networking / localhost):
#   DATABASE_URL=postgresql://pkpways:<POSTGRES_PASSWORD>@localhost:5432/pkpways
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
