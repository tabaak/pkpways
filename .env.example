# Docker Compose datastore config. Copy to .env and set real passwords.
#   cp .env.example .env
# .env is gitignored — never commit it.

# --- PostgreSQL ---
POSTGRES_DB=pkpways
POSTGRES_USER=pkpways
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Redis ---
REDIS_PASSWORD=replace-with-a-strong-password

# --- data-sync worker ---
# The worker runs as a compose service and builds DATABASE_URL / REDIS_URL from
# the values above (hosts "postgres"/"redis"), so you only need the API key.
PKP_API_KEY=replace-with-your-pkp-api-key
# Optional overrides:
# PKP_API_BASE_URL=https://pdp-api.plk-sa.pl/api/v1
# POLL_INTERVAL_SECONDS=30
# REQUEST_TIMEOUT_SECONDS=10
# LOG_LEVEL=INFO
