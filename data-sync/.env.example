# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# PKP PLK Open Data API — https://pdp-api.plk-sa.pl/
PKP_API_BASE_URL=https://pdp-api.plk-sa.pl/api/v1
PKP_API_KEY=replace-with-your-api-key

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/pkpways

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# How often to poll the PKP API, in seconds
POLL_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
