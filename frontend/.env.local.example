# Frontend server-side datastore connections (read-only use).
# Copy to `.env.local` and fill from the root deployment `.env`
# (POSTGRES_PASSWORD / REDIS_PASSWORD).
#
# The datastores are bound to 127.0.0.1 on the VPS. To develop locally against
# them, open an SSH tunnel first, then use 127.0.0.1 URLs below:
#
#   ssh -N -L 5432:localhost:5432 -L 6379:localhost:6379 oracle_vps
#
# When the frontend runs ON the VPS (same Docker network / host), use the
# service hostnames `postgres` / `redis` instead of localhost.

DATABASE_URL=postgresql://pkpways:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/pkpways
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0

# Max live train markers sent to the browser (keeps Leaflet responsive).
# MAX_TRAINS=1500

# Optional: CARTO basemap API key (removes "API KEY REQUIRED" watermark).
# Get a free key at https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=
